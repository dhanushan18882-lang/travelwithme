# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# =============================================================================
# SENDGRID EMAIL CONFIGURATION
# =============================================================================

# SendGrid API Key (Get from: https://app.sendgrid.com/settings/api_keys)
# REQUIRED for sending emails
SENDGRID_API_KEY=your_sendgrid_api_key_here

# Business Email - Where contact form submissions are sent
BUSINESS_EMAIL=musichubyt123@gmail.com

# Business Name - Displayed in emails
BUSINESS_NAME=TravelWithMe - Sri Lanka

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# API Base URL
# Development: http://localhost:3000
# Production: https://your-domain.com
VITE_API_URL=http://localhost:3000

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://travelwithme.lk

# Rate Limiting
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW=3600000

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit .env.local to Git
# 2. Keep your SendGrid API key secure
# 3. Update VITE_API_URL for production deployment
# 4. Add these variables to your hosting platform (Vercel/Netlify)
